# CMake, IDE and packaging output
/out/
/build/
/dist/
/tmp/
/Testing/
/_CPack_Packages/
/*.zip
/*.zip.sha256
/.transactions/
/.cache/
/compile_commands.json
/CMakeUserPresets.json
/.vs/
/.vscode/
/.idea/

# Local tool and assistant state
/.ida-mcp/
/.claude/

# Python tooling caches
__pycache__/
*.py[cod]

# Retail content is imported from the player's existing Ace of Spades install.
# It must never enter normal Git history or release source archives.
/assets/original/

# Generated and writable runtime data
/assets/generated/*
!/assets/generated/.gitkeep
/assets/user/*
!/assets/user/.gitkeep
/settings.toml
/server_favorites.txt

# Runtime diagnostics, captures and scratch files
*.dmp
*.log
*.trace
/*.png
/*.jpg
/*.bmp
/*.csv
*.bak
*.orig
*.rej
*.tmp
*.swp
*~

# Reverse-engineering databases (retail binaries and their analyses stay local)
*.id0
*.id1
*.id2
*.id3
*.id4
*.i64
*.idb
*.nam
*.til
*.pyd
*.pyc

# Credentials and local service configuration
.env
.env.*
rclone.conf
*.pem
*.pfx
*.p12
*.key

# Platform/editor noise
.DS_Store
Thumbs.db
*.user
*.suo
*.VC.db
