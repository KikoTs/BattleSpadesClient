+		VkDescriptorSet allocateDescriptorSet(VkDescriptorSetLayout _layout)
+		{
+			VkDescriptorSetAllocateInfo dsai;
+			dsai.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO;
+			dsai.pNext = NULL;
+			dsai.descriptorSetCount = 1;
+			dsai.pSetLayouts = &_layout;
+
+			VkResult result = VK_ERROR_OUT_OF_POOL_MEMORY;
+			const uint32_t numPools = uint32_t(m_descriptorPools.size() );
+			for (uint32_t ii = 0; ii <= numPools; ++ii)
+			{
+				// Reuse all existing pools before adding one overflow pool.
+				if (ii == numPools)
+				{
+					result = createDescriptorPool();
+					if (VK_SUCCESS != result)
+					{
+						break;
+					}
+				}
+
+				DescriptorPool& pool = m_descriptorPools[ii];
+				if (pool.m_numSets >= MAX_DESCRIPTOR_SETS)
+				{
+					continue;
+				}
+				dsai.descriptorPool = pool.m_pool;
+				VkDescriptorSet descriptorSet = VK_NULL_HANDLE;
+				result = vkAllocateDescriptorSets(m_device, &dsai, &descriptorSet);
+				if (VK_SUCCESS == result && VK_NULL_HANDLE != descriptorSet)
+				{
+					++pool.m_numSets;
+					m_descriptorSetOwners[uint64_t(descriptorSet.vk)] = ii;
+					return descriptorSet;
+				}
+
+				if (VK_SUCCESS == result)
+				{
+					result = VK_ERROR_INITIALIZATION_FAILED;
+				}
+
+				if (ii == numPools)
+				{
+					// A fresh pool that cannot satisfy this layout is not useful.
+					vkDestroy(pool.m_pool);
+					m_descriptorPools.pop_back();
+				}
+
+				if (VK_ERROR_OUT_OF_POOL_MEMORY != result && VK_ERROR_FRAGMENTED_POOL != result)
+				{
+					break;
+				}
+			}
+
+			// VK_CHECK discards errors in Release; never update or bind an invalid set.
+			reportDescriptorSetFailure(result);
+			return VK_NULL_HANDLE;
+		}
+
+		void freeDescriptorSet(VkDescriptorSet& _set)
+		{
+			const auto owner = m_descriptorSetOwners.find(uint64_t(_set.vk) );
+			BX_ASSERT(owner != m_descriptorSetOwners.end(), "Descriptor set has no owning pool.");
+			if (owner != m_descriptorSetOwners.end() )
+			{
+				DescriptorPool& pool = m_descriptorPools[owner->second];
+				VkResult result = vkFreeDescriptorSets(m_device, pool.m_pool, 1, &_set);
+				if (VK_SUCCESS != result)
+				{
+					reportDescriptorSetFailure(result);
+				}
+				m_descriptorSetOwners.erase(owner);
+				if (0 == --pool.m_numSets)
+				{
+					// The release queue is fence-safe. Reset an empty pool to remove fragmentation.
+					result = vkResetDescriptorPool(m_device, pool.m_pool, 0);
+					if (VK_SUCCESS != result)
+					{
+						reportDescriptorSetFailure(result);
+					}
+				}
+			}
+			_set = VK_NULL_HANDLE;
+		}
