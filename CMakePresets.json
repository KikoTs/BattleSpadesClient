{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "AOS_BUILD_TESTS": "ON",
        "AOS_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "native-windows-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "AOS_BUILD_TESTS": "ON",
        "AOS_ENABLE_NATIVE_BACKENDS": "ON",
        "AOS_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_installed",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "native-windows-arm64-base",
      "hidden": true,
      "inherits": "native-windows-base",
      "cacheVariables": {
        "VCPKG_HOST_TRIPLET": "arm64-windows",
        "VCPKG_TARGET_TRIPLET": "arm64-windows"
      }
    },
    {
      "name": "native-linux-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "AOS_BUILD_TESTS": "ON",
        "AOS_ENABLE_NATIVE_BACKENDS": "ON",
        "AOS_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_installed",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
      }
    },
    {
      "name": "native-macos-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "AOS_BUILD_TESTS": "ON",
        "AOS_ENABLE_NATIVE_BACKENDS": "ON",
        "AOS_WARNINGS_AS_ERRORS": "ON",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/out/vcpkg_installed",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Unoptimized build with full debug information and assertions",
      "inherits": "windows-base",
      "cacheVariables": {
        "AOS_BUILD_PROFILE": "debug"
      }
    },
    {
      "name": "dev",
      "displayName": "Development",
      "description": "Optimized developer build with symbols and assertions",
      "inherits": "windows-base",
      "cacheVariables": {
        "AOS_BUILD_PROFILE": "dev"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized distribution build",
      "inherits": "windows-base",
      "cacheVariables": {
        "AOS_BUILD_PROFILE": "release"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native Debug",
      "description": "Graphical Debug build using pinned vcpkg dependencies",
      "inherits": "native-windows-base",
      "cacheVariables": {
        "AOS_BUILD_PROFILE": "debug"
      }
    },
    {
      "name": "native-dev",
      "displayName": "Native Development",
      "description": "Graphical optimized developer build with symbols",
      "inherits": "native-windows-base",
      "cacheVariables": {
        "AOS_BUILD_PROFILE": "dev"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native Release",
      "description": "Graphical optimized distribution build",
      "inherits": "native-windows-base",
      "cacheVariables": {
        "AOS_BUILD_PROFILE": "release"
      }
    },
    {
      "name": "native-windows-arm64-dev",
      "displayName": "Native Development (Windows on Arm)",
      "description": "Graphical optimized developer build with symbols for arm64 Windows",
      "inherits": "native-windows-arm64-base",
      "cacheVariables": {
        "AOS_BUILD_PROFILE": "dev"
      }
    },
    {
      "name": "native-windows-arm64-release",
      "displayName": "Native Release (Windows on Arm)",
      "description": "Graphical optimized distribution build for arm64 Windows",
      "inherits": "native-windows-arm64-base",
      "cacheVariables": {
        "AOS_BUILD_PROFILE": "release"
      }
    },
    {
      "name": "native-linux-dev",
      "displayName": "Linux Native Development",
      "description": "Graphical Linux build using SDL3, bgfx, Vulkan/OpenGL and OpenAL",
      "inherits": "native-linux-base",
      "cacheVariables": {
        "AOS_BUILD_PROFILE": "dev"
      }
    },
    {
      "name": "native-linux-release",
      "displayName": "Linux Native Release",
      "description": "Graphical Linux distribution build",
      "inherits": "native-linux-base",
      "cacheVariables": {
        "AOS_BUILD_PROFILE": "release"
      }
    },
    {
      "name": "native-macos-dev",
      "displayName": "macOS Native Development",
      "description": "Graphical macOS build using SDL3, bgfx Metal and OpenAL",
      "inherits": "native-macos-base",
      "cacheVariables": {
        "AOS_BUILD_PROFILE": "dev"
      }
    },
    {
      "name": "native-macos-release",
      "displayName": "macOS Native Release",
      "description": "Graphical macOS distribution build",
      "inherits": "native-macos-base",
      "cacheVariables": {
        "AOS_BUILD_PROFILE": "release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "configuration": "Debug"
    },
    {
      "name": "native-dev",
      "configurePreset": "native-dev",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "configuration": "Release"
    },
    {
      "name": "native-windows-arm64-dev",
      "configurePreset": "native-windows-arm64-dev",
