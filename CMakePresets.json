    },
    {
      "name": "native-windows-arm64-release",
      "configurePreset": "native-windows-arm64-release",
      "configuration": "Release"
    },
    {
      "name": "native-linux-dev",
      "configurePreset": "native-linux-dev",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "native-linux-release",
      "configurePreset": "native-linux-release",
      "configuration": "Release"
    },
    {
      "name": "native-macos-dev",
      "configurePreset": "native-macos-dev",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "native-macos-release",
      "configurePreset": "native-macos-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev",
